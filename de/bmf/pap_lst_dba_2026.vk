example spain_class_vi_5000 {
  label de "Prüftabelle: 5.000 € Versorgungsbezüge, DBA Spanien, Steuerklasse VI – 250 € (5 %)"
  label en "Test table: pension of 5,000 euros, treaty with Spain, class VI – 250 euros (5 %)"
  source "PAP DBA ab 2026, Prüftabelle (Seite 14)"
  statement lean "limited_wage_tax.lstlzz { land := .spain, stkl := .vi, lzz := .year, ins := { krv := true, alv := false, pkv := false, kvz := 29 / 10, pvs := false, pvz := true, pva := 0, pkpv := 0, pkpvagz := 0 }, vbez := 5000, vbezm := 41666 / 100, vbezs := 0, vjahr := 2026, zmvb := 12, vbs := 0, sterbe := 0, sonstent := 0, jvbez := 0, jre4ent := 0, jfreib := 0, jhinzu := 0, lzzfreib := 0, lzzhinzu := 0 } = 250"
