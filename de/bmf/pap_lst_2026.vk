norm pension_allowance {
  label de "Freibeträge für Versorgungsbezüge (MRE4)"
  label en "Allowances for pensions (MRE4)"
  source "PAP 2026, MRE4 (§ 19 Abs. 2 EStG, § 39b Abs. 2 Satz 3 EStG)"

  input annual : bool {
    label de "Jahresberechnung (LZZ = 1, bei sonstigen Bezügen immer)"
    label en "computed for a year (LZZ = 1, always for other emoluments)"
  }
  input zmvb : int {
    label de "Zahl der Monate mit Versorgungsbezügen im Kalenderjahr (ZMVB)"
    label en "number of months with pensions in the calendar year (ZMVB)"
  }
  input vjahr : int {
    label de "Jahr des Versorgungsbeginns (VJAHR)"
    label en "year the pension began (VJAHR)"
  }
  input vbezm : money {
    label de "Versorgungsbezug im Januar 2005 bzw. im ersten vollen Monat (VBEZM)"
    label en "pension in January 2005 or in the first full month (VBEZM)"
  }
  input vbezs : money {
    label de "voraussichtliche Sonderzahlungen im Jahr des Versorgungsbeginns (VBEZS)"
    label en "expected special payments in the year the pension began (VBEZS)"
  }
  input vbezbso : money {
    label de "Bemessungsgrundlage aus Sterbegeld und Kapitalauszahlungen (VBEZBSO)"
    label en "base from death benefits and lump sums (VBEZBSO)"
  }
  input zvbezj : money {
    label de "auf ein Jahr hochgerechnete Versorgungsbezüge (ZVBEZJ)"
    label en "pensions projected to a year (ZVBEZJ)"
  }

  rule tab1 : decimal = pension_tables.tab1(vjahr = vjahr) {
    label de "TAB1(J)"
    label en "TAB1(J)"
  }
  rule tab2 : money = pension_tables.tab2(vjahr = vjahr) {
    label de "TAB2(J)"
    label en "TAB2(J)"
  }
  rule tab3 : money = pension_tables.tab3(vjahr = vjahr) {
    label de "TAB3(J)"
    label en "TAB3(J)"
  }
  rule vbezb : money = if annual then vbezm * zmvb + vbezs else vbezm * 12 + vbezs {
    label de "Bemessungsgrundlage für den Versorgungsfreibetrag (VBEZB)"
    label en "base of the allowance for pensions (VBEZB)"
  }
  rule hfvb : money = if annual then round_up(tab2 / 12 * zmvb, 1 EUR) else tab2 {
    label de "maßgeblicher Höchstbetrag des Versorgungsfreibetrags (HFVB)"
    label en "applicable maximum of the allowance (HFVB)"
  }
  rule fvbz_table : money = if annual then round_up(tab3 / 12 * zmvb, 1 EUR) else tab3 {
    label de "Zuschlag zum Versorgungsfreibetrag vor der Begrenzung (FVBZ)"
    label en "supplement before its limit (FVBZ)"
  }
  rule fvb : money {
    label de "Versorgungsfreibetrag (FVB)"
    label en "allowance for pensions (FVB)"
    default min(min(round_up(vbezb * tab1, 0.01 EUR), hfvb), zvbezj)
    unless zvbezj == 0 EUR then 0 EUR
  }
  rule fvbso : money {
    label de "Versorgungsfreibetrag für den sonstigen Bezug (FVBSO)"
    label en "allowance for pensions with the other emolument (FVBSO)"
    default min(round_up(fvb + vbezbso * tab1, 0.01 EUR), tab2)
    unless zvbezj == 0 EUR then 0 EUR
  }
  rule hfvbzso : money = round_down(vbezb + vbezbso - fvbso, 0.01 EUR) {
    label de "Höchstbetrag des Zuschlags für den sonstigen Bezug (HFVBZSO)"
    label en "maximum of the supplement with the other emolument (HFVBZSO)"
  }
  rule fvbzso_raw : money = round_up(fvbz_table + vbezbso, 1 EUR) {
    label de "Zuschlag für den sonstigen Bezug vor der Begrenzung (FVBZSO)"
    label en "supplement with the other emolument before its limits (FVBZSO)"
  }
  rule fvbzso : money {
    label de "Zuschlag zum Versorgungsfreibetrag für den sonstigen Bezug (FVBZSO)"
    label en "supplement with the other emolument (FVBZSO)"
    default min(if fvbzso_raw > hfvbzso then round_up(hfvbzso, 1 EUR) else fvbzso_raw, tab3)
    unless zvbezj == 0 EUR then 0 EUR
  }
  rule hfvbz : money = round_down(vbezb - fvb, 0.01 EUR) {
    label de "Höchstbetrag des Zuschlags (HFVBZ)"
    label en "maximum of the supplement (HFVBZ)"
  }
  rule fvbz : money {
    label de "Zuschlag zum Versorgungsfreibetrag (FVBZ)"
    label en "supplement to the allowance for pensions (FVBZ)"
    default if fvbz_table > hfvbz then round_up(hfvbz, 1 EUR) else fvbz_table
    unless zvbezj == 0 EUR then 0 EUR
  }
}

norm old_age_relief {
  label de "Altersentlastungsbetrag (MRE4ALTE)"
  label en "Relief for old age (MRE4ALTE)"
  source "PAP 2026, MRE4ALTE (§ 24a EStG, § 39b Abs. 2 Satz 3 EStG)"

  input alter1 : bool {
    label de "64. Lebensjahr vor Beginn des Kalenderjahres vollendet (ALTER1 = 1)"
    label en "64 years old before the calendar year began (ALTER1 = 1)"
  }
  input ajahr : int {
    label de "auf die Vollendung des 64. Lebensjahres folgendes Kalenderjahr (AJAHR)"
    label en "calendar year after the 64th birthday (AJAHR)"
  }
  input zre4j : money {
    label de "Jahresarbeitslohn (ZRE4J)"
    label en "annual wage (ZRE4J)"
  }
  input zvbezj : money {
    label de "darin enthaltene Versorgungsbezüge (ZVBEZJ)"
    label en "pensions in it (ZVBEZJ)"
  }

  rule alte : money {
    label de "Altersentlastungsbetrag (ALTE)"
    label en "relief for old age (ALTE)"
    default min(round_up((zre4j - zvbezj) * relief_tables.tab4(ajahr = ajahr), 1 EUR), relief_tables.tab5(ajahr = ajahr))
    unless not alter1 then 0 EUR
  }
}

norm annual_wage_tax {
  label de "Jahressteuer auf einen Jahresarbeitslohn (MRE4ABZ, MZTABFB, MLSTJAHR)"
  label en "Annual tax on an annual wage (MRE4ABZ, MZTABFB, MLSTJAHR)"
  source "PAP 2026, MRE4ABZ, MZTABFB, MLSTJAHR, UPEVP, MVSPKVPV, MVSPHB"

  input stkl : tax_class {
    label de "Steuerklasse (STKL)"
    label en "tax class (STKL)"
  }
  input zkf : decimal {
    label de "Zahl der Freibeträge für Kinder (ZKF)"
    label en "number of allowances for children (ZKF)"
  }
  input ins : insurance {
    label de "Merker für die Vorsorgepauschale"
    label en "markers for the provident lump sum"
  }
  input zre4j : money {
    label de "Jahresarbeitslohn (ZRE4J)"
    label en "annual wage (ZRE4J)"
  }
  input zvbezj : money {
    label de "darin enthaltene Versorgungsbezüge (ZVBEZJ)"
    label en "pensions in it (ZVBEZJ)"
  }
  input fvb : money {
    label de "Versorgungsfreibetrag (FVB, beim sonstigen Bezug FVBSO)"
    label en "allowance for pensions (FVB, with the other emolument FVBSO)"
  }
  input fvbz : money {
    label de "Zuschlag zum Versorgungsfreibetrag (FVBZ, beim sonstigen Bezug FVBZSO)"
    label en "supplement to it (FVBZ, with the other emolument FVBZSO)"
  }
  input alte : money {
    label de "Altersentlastungsbetrag (ALTE)"
    label en "relief for old age (ALTE)"
  }
  input jlfreib : money {
    label de "Jahresfreibetrag (JLFREIB)"
    label en "annual allowance on the wage tax card (JLFREIB)"
  }
  input jlhinzu : money {
    label de "Jahreshinzurechnungsbetrag (JLHINZU)"
    label en "annual addition on the wage tax card (JLHINZU)"
  }
  input ent : money {
    label de "von ZRE4VP abzuziehen: Entschädigungen, abzüglich nicht zu besteuernder Vorteile (JRE4ENT, SONSTENT, MBV)"
    label en "to deduct from ZRE4VP: compensation, less untaxed benefits (JRE4ENT, SONSTENT, MBV)"
  }

  // MPARA
  constant bbgrvalv : money = 101_400 EUR {
    label de "Beitragsbemessungsgrenze Renten- und Arbeitslosenversicherung (BBGRVALV)"
    label en "contribution ceiling, pension and unemployment insurance (BBGRVALV)"
    source "PAP 2026, MPARA"
  }
  constant avsatzan : decimal = 0.013 {
    label de "Arbeitnehmeranteil Arbeitslosenversicherung (AVSATZAN)"
    label en "employee's rate, unemployment insurance (AVSATZAN)"
    source "PAP 2026, MPARA"
  }
  constant rvsatzan : decimal = 0.093 {
    label de "Arbeitnehmeranteil Rentenversicherung (RVSATZAN)"
    label en "employee's rate, pension insurance (RVSATZAN)"
    source "PAP 2026, MPARA"
  }
  constant bbgkvpv : money = 69_750 EUR {
    label de "Beitragsbemessungsgrenze Kranken- und Pflegeversicherung (BBGKVPV)"
    label en "contribution ceiling, health and long-term care insurance (BBGKVPV)"
    source "PAP 2026, MPARA"
  }
  rule kvsatzan : decimal = round_down(ins.kvz / 2 / 100 + 0.07, 0.00001) {
    label de "Arbeitnehmeranteil Krankenversicherung (KVSATZAN, 5 Nachkommastellen)"
    label en "employee's rate, health insurance (KVSATZAN, 5 decimal places)"
    source "PAP 2026, MPARA"
  }
  rule pvsatzan : decimal {
    label de "Arbeitnehmeranteil Pflegeversicherung (PVSATZAN)"
    label en "employee's rate, long-term care insurance (PVSATZAN)"
    source "PAP 2026, MPARA"
    default (if ins.pvs then 0.023 else 0.018) - ins.pva * 0.0025
    unless ins.pvz then (if ins.pvs then 0.023 else 0.018) + 0.006
  }

  // MRE4ABZ
  rule zre4 : money = max(round_down(zre4j - fvb - alte - jlfreib + jlhinzu, 0.01 EUR), 0 EUR) {
    label de "Jahresarbeitslohn nach Abzug der Freibeträge (ZRE4)"
    label en "annual wage after allowances (ZRE4)"
    source "PAP 2026, MRE4ABZ (§ 39b Abs. 2 Satz 3 und 4 EStG)"
  }
  rule zre4vp : money = zre4j - ent {
    label de "Jahresarbeitslohn für die Vorsorgepauschale (ZRE4VP)"
    label en "annual wage for the provident lump sum (ZRE4VP)"
    source "PAP 2026, MRE4ABZ, MOSONST, MRE4SONST"
  }
  rule zvbez : money = max(round_down(zvbezj - fvb, 0.01 EUR), 0 EUR) {
    label de "Versorgungsbezüge nach Abzug des Versorgungsfreibetrags (ZVBEZ)"
    label en "pensions after their allowance (ZVBEZ)"
    source "PAP 2026, MRE4ABZ"
  }

  // MZTABFB
  rule fvbz_limited : money = if zvbez < fvbz then round_down(zvbez, 1 EUR) else fvbz {
    label de "Zuschlag zum Versorgungsfreibetrag, höchstens ZVBEZ (FVBZ)"
    label en "supplement to the allowance, at most ZVBEZ (FVBZ)"
    source "PAP 2026, MZTABFB"
  }
  rule fvbz_table : money {
    label de "Zuschlag zum Versorgungsfreibetrag in den Tabellenfreibeträgen (FVBZ)"
    label en "supplement to the allowance among the fixed allowances (FVBZ)"
    source "PAP 2026, MZTABFB"
    by stkl
    vi: 0 EUR
    otherwise: fvbz_limited
  }
  rule anp_pension : money {
    label de "Werbungskosten-Pauschbetrag für Versorgungsbezüge (ANP)"
    label en "lump sum for expenses on pensions (ANP)"
    source "PAP 2026, MZTABFB (§ 9a Satz 1 Nr. 1 Buchst. b EStG)"
    default if zvbez > 0 EUR then (if zvbez - fvbz_limited < 102 EUR then round_up(zvbez - fvbz_limited, 1 EUR) else 102 EUR) else 0 EUR
    unless stkl == tax_class.vi then 0 EUR
  }
  rule anp : money {
    label de "Arbeitnehmer-Pauschbetrag/Werbungskosten-Pauschbetrag (ANP)"
    label en "employee's lump sum and lump sum for expenses (ANP)"
    source "PAP 2026, MZTABFB (§ 9a Satz 1 Nr. 1 Buchst. a EStG)"
    default if zre4 > zvbez then (if zre4 - zvbez < 1_230 EUR then round_up(anp_pension + zre4 - zvbez, 1 EUR) else anp_pension + 1_230 EUR) else anp_pension
    unless stkl == tax_class.vi then 0 EUR
  }
  rule efa : money {
    label de "Entlastungsbetrag für Alleinerziehende (EFA)"
    label en "relief for single parents (EFA)"
    source "PAP 2026, MZTABFB (§ 24b EStG)"
    by stkl
    ii: 4_260 EUR
    otherwise: 0 EUR
  }
  rule sap : money {
    label de "Sonderausgaben-Pauschbetrag (SAP)"
    label en "lump sum for special expenses (SAP)"
    source "PAP 2026, MZTABFB (§ 10c EStG)"
    by stkl
    vi: 0 EUR
    otherwise: 36 EUR
  }
  rule kztab : int {
    label de "Tarifart (KZTAB): 1 Grundtarif, 2 Splittingverfahren"
    label en "kind of scale (KZTAB): 1 basic, 2 splitting"
    source "PAP 2026, MZTABFB"
    by stkl
    iii: 2
    otherwise: 1
  }
  rule kfb : money {
    label de "Summe der Freibeträge für Kinder (KFB)"
    label en "sum of the allowances for children (KFB)"
    source "PAP 2026, MZTABFB"
    by stkl
    iv: round_down(zkf * 4_878 EUR, 1 EUR)
    v: 0 EUR
    vi: 0 EUR
    otherwise: round_down(zkf * 9_756 EUR, 1 EUR)
  }
  rule ztabfb : money = round_down(efa + anp + sap + fvbz_table, 0.01 EUR) {
    label de "feste Tabellenfreibeträge (ZTABFB)"
    label en "fixed allowances of the tables (ZTABFB)"
    source "PAP 2026, MZTABFB"
  }

  // UPEVP, MVSPKVPV, MVSPHB
  rule vspr : money = if ins.krv then 0 EUR else round_down(min(zre4vp, bbgrvalv) * rvsatzan, 0.01 EUR) {
    label de "Teilbetrag Rentenversicherung (VSPR)"
    label en "share for pension insurance (VSPR)"
    source "PAP 2026, UPEVP"
  }
  rule vspkvpv : money {
    label de "Teilbetrag Kranken- und Pflegeversicherung (VSPKVPV)"
    label en "share for health and long-term care insurance (VSPKVPV)"
    source "PAP 2026, MVSPKVPV"
    default round_down(min(zre4vp, bbgkvpv) * (kvsatzan + pvsatzan), 0.01 EUR)
    unless ins.pkv and stkl == tax_class.vi then 0 EUR
    unless ins.pkv then max(round_down(ins.pkpv * 12, 0.01 EUR) - round_down(ins.pkpvagz * 12, 0.01 EUR), 0 EUR)
  }
  rule vsp_basic : money = round_up(vspkvpv + vspr, 1 EUR) {
    label de "Vorsorgepauschale (VSP) vor der Höchstbetragsberechnung"
    label en "provident lump sum (VSP) before the ceiling"
    source "PAP 2026, MVSPKVPV"
  }
  rule vspalv : money = round_down(avsatzan * min(zre4vp, bbgrvalv), 0.01 EUR) {
    label de "Teilbetrag Arbeitslosenversicherung (VSPALV)"
    label en "share for unemployment insurance (VSPALV)"
    source "PAP 2026, MVSPHB"
  }
  rule vsphb : money = min(vspalv + vspkvpv, 1_900 EUR) {
    label de "auf den Höchstbetrag begrenzte Beiträge (VSPHB)"
    label en "contributions up to the ceiling (VSPHB)"
    source "PAP 2026, MVSPHB"
  }
  rule vspn : money = round_up(vspr + vsphb, 1 EUR) {
    label de "Vorsorgepauschale mit Höchstbetrag (VSPN)"
    label en "provident lump sum with the ceiling (VSPN)"
    source "PAP 2026, MVSPHB"
  }
  rule vsp : money {
    label de "Vorsorgepauschale (VSP)"
    label en "provident lump sum (VSP)"
    source "PAP 2026, UPEVP (§ 39b Abs. 2 Satz 5 Nr. 3 EStG)"
    default if vspn > vsp_basic then vspn else vsp_basic
    unless ins.alv or stkl == tax_class.vi then vsp_basic
  }

  // MLSTJAHR, UPMLST
  rule zve : money = zre4 - ztabfb - vsp {
    label de "zu versteuerndes Einkommen (ZVE)"
    label en "taxable income (ZVE)"
    source "PAP 2026, MLSTJAHR"
  }
  rule st : money = annual_tax.st(stkl = stkl, kztab = kztab, zve = zve) {
    label de "Jahressteuer (ST)"
    label en "annual tax (ST)"
    source "PAP 2026, UPMLST"
  }
  rule st_children : money = annual_tax.st(stkl = stkl, kztab = kztab, zve = zve - kfb) {
    label de "Jahressteuer mit den Freibeträgen für Kinder (ST, Grundlage von JBMG und SOLZSBMG)"
    label en "annual tax with the allowances for children (ST, base of JBMG and SOLZSBMG)"
    source "PAP 2026, MBERECH, MSOLZSTS (§ 51a EStG)"
  }

  // Outputs for the plan on double taxation treaties (Anlage 3)
  rule vfrb : money = anp + fvb + fvbz_table {
    label de "verbrauchter Freibetrag (VFRB, VFRBS1, VFRBS2 vor Abzug)"
    label en "allowance used (VFRB, VFRBS1, VFRBS2 before the deduction)"
    source "PAP 2026, MBERECH, MOSONST, MRE4SONST"
  }
  rule wvfrb : money = max(zve - tariff.gfb, 0 EUR) {
    label de "verfügbares ZVE über dem Grundfreibetrag (WVFRB, WVFRBO, WVFRBM)"
    label en "taxable income above the basic allowance (WVFRB, WVFRBO, WVFRBM)"
    source "PAP 2026, MBERECH, MOSONST, MSONST"
  }
}

norm wage_tax {
  label de "Lohnsteuer 2026 auf laufenden Arbeitslohn und sonstige Bezüge"
  label en "Wage tax 2026 on current wages and other emoluments"
  source "PAP 2026, Anlage 1 zum BMF-Schreiben vom 12.11.2025"
  valid from 2026-01-01 to 2026-12-31

  input stkl : tax_class {
    label de "Steuerklasse (STKL)"
    label en "tax class (STKL)"
  }
  input lzz : pay_period {
    label de "Lohnzahlungszeitraum (LZZ)"
    label en "pay period (LZZ)"
  }
  input wage : money {
    label de "steuerpflichtiger Arbeitslohn für den Lohnzahlungszeitraum (RE4)"
    label en "taxable wage for the pay period (RE4)"
  }
  input zkf : decimal {
    label de "Zahl der Freibeträge für Kinder (ZKF, eine Dezimalstelle, nur Steuerklassen I bis IV)"
    label en "number of allowances for children (ZKF, one decimal place, tax classes I to IV only)"
  }
  input r : bool {
    label de "Mitglied einer Religionsgemeinschaft (R > 0)"
    label en "member of a religious community (R > 0)"
  }
  input ins : insurance {
    label de "Merker für die Vorsorgepauschale (KRV, ALV, PKV, KVZ, PVS, PVZ, PVA, PKPV, PKPVAGZ)"
    label en "markers for the provident lump sum (KRV, ALV, PKV, KVZ, PVS, PVZ, PVA, PKPV, PKPVAGZ)"
  }
  input af : bool {
    label de "Faktorverfahren gewählt (AF = 1, nur Steuerklasse IV)"
    label en "factor method chosen (AF = 1, tax class IV only)"
  }
  input f : decimal {
    label de "eingetragener Faktor (F, drei Nachkommastellen)"
    label en "factor entered (F, three decimal places)"
  }
  input lzzfreib : money {
    label de "Freibetrag für den Lohnzahlungszeitraum (LZZFREIB)"
    label en "allowance for the pay period on the wage tax card (LZZFREIB)"
  }
  input lzzhinzu : money {
    label de "Hinzurechnungsbetrag für den Lohnzahlungszeitraum (LZZHINZU)"
    label en "addition for the pay period on the wage tax card (LZZHINZU)"
  }
  input vbez : money {
    label de "in RE4 enthaltene Versorgungsbezüge (VBEZ)"
    label en "pensions in RE4 (VBEZ)"
  }
  input vbezm : money {
    label de "Versorgungsbezug im Januar 2005 bzw. im ersten vollen Monat (VBEZM)"
    label en "pension in January 2005 or in the first full month (VBEZM)"
  }
  input vbezs : money {
    label de "voraussichtliche Sonderzahlungen im Jahr des Versorgungsbeginns (VBEZS)"
    label en "expected special payments in the year the pension began (VBEZS)"
  }
  input vjahr : int {
    label de "Jahr des Versorgungsbeginns (VJAHR)"
    label en "year the pension began (VJAHR)"
  }
  input zmvb : int {
    label de "Zahl der Monate mit Versorgungsbezügen im Kalenderjahr (ZMVB, nötig bei LZZ = 1)"
    label en "number of months with pensions in the calendar year (ZMVB, needed if LZZ = 1)"
  }
  input alter1 : bool {
    label de "64. Lebensjahr vor Beginn des Kalenderjahres vollendet (ALTER1 = 1)"
    label en "64 years old before the calendar year began (ALTER1 = 1)"
  }
  input ajahr : int {
    label de "auf die Vollendung des 64. Lebensjahres folgendes Kalenderjahr (AJAHR)"
    label en "calendar year after the 64th birthday (AJAHR)"
  }
  input sonstb : money {
    label de "sonstige Bezüge (SONSTB)"
    label en "other emoluments (SONSTB)"
  }
  input sonstent : money {
    label de "darin enthaltene Entschädigungen und zu besteuernde Vorteile aus Vermögensbeteiligungen (SONSTENT)"
    label en "compensation and taxable benefits from employee shares in them (SONSTENT)"
  }
  input sterbe : money {
    label de "darin enthaltenes Sterbegeld und Kapitalauszahlungen/Abfindungen (STERBE)"
    label en "death benefits and lump sums in them (STERBE)"
  }
  input vbs : money {
    label de "darin enthaltene Versorgungsbezüge einschließlich Sterbegeld (VBS)"
    label en "pensions in them, death benefits included (VBS)"
  }
  input mbv : money {
    label de "nicht zu besteuernde Vorteile bei Vermögensbeteiligungen (MBV)"
    label en "untaxed benefits from employee shares (MBV)"
  }
  input jre4 : money {
    label de "voraussichtlicher Jahresarbeitslohn ohne sonstige Bezüge (JRE4)"
    label en "expected annual wage without other emoluments (JRE4)"
  }
  input jre4ent : money {
    label de "darin enthaltene Entschädigungen und zu besteuernde Vorteile aus Vermögensbeteiligungen (JRE4ENT)"
    label en "compensation and taxable benefits from employee shares in it (JRE4ENT)"
  }
  input jvbez : money {
    label de "darin enthaltene Versorgungsbezüge (JVBEZ)"
    label en "pensions in it (JVBEZ)"
  }
  input jfreib : money {
    label de "Jahresfreibetrag für sonstige Bezüge (JFREIB)"
    label en "annual allowance for other emoluments (JFREIB)"
  }
  input jhinzu : money {
    label de "Jahreshinzurechnungsbetrag für sonstige Bezüge (JHINZU)"
    label en "annual addition for other emoluments (JHINZU)"
  }

  constant solzfrei : money = 20_350 EUR {
    label de "Freigrenze Solidaritätszuschlag (SOLZFREI)"
    label en "exemption limit, solidarity surcharge (SOLZFREI)"
    source "PAP 2026, MPARA"
  }

  rule factor : decimal = if af then f else 1 {
    label de "anzuwendender Faktor (F)"
    label en "factor applied (F)"
    source "PAP 2026, MRE4JL (§ 39f EStG)"
  }
  rule kztab : int {
    label de "Tarifart (KZTAB)"
    label en "kind of scale (KZTAB)"
    source "PAP 2026, MZTABFB"
    by stkl
    iii: 2
    otherwise: 1
  }

  // MRE4JL
  rule zre4j : money = projection.year(lzz = lzz, amount = wage) {
    label de "auf einen Jahreslohn hochgerechneter Arbeitslohn (ZRE4J)"
    label en "wage projected to a year (ZRE4J)"
    source "PAP 2026, MRE4JL"
  }
  rule zvbezj : money = projection.year(lzz = lzz, amount = vbez) {
    label de "auf einen Jahreslohn hochgerechnete Versorgungsbezüge (ZVBEZJ)"
    label en "pensions projected to a year (ZVBEZJ)"
    source "PAP 2026, MRE4JL"
  }
  rule jlfreib : money = projection.year(lzz = lzz, amount = lzzfreib) {
    label de "auf einen Jahreslohn hochgerechneter Freibetrag (JLFREIB)"
    label en "allowance projected to a year (JLFREIB)"
    source "PAP 2026, MRE4JL"
  }
  rule jlhinzu : money = projection.year(lzz = lzz, amount = lzzhinzu) {
    label de "auf einen Jahreslohn hochgerechneter Hinzurechnungsbetrag (JLHINZU)"
    label en "addition projected to a year (JLHINZU)"
    source "PAP 2026, MRE4JL"
  }

  // MRE4, MRE4ALTE
  rule fvb : money = pension_allowance.fvb(annual = lzz == pay_period.year, zmvb = zmvb, vjahr = vjahr, vbezm = vbezm, vbezs = vbezs, vbezbso = 0 EUR, zvbezj = zvbezj) {
    label de "Versorgungsfreibetrag (FVB)"
    label en "allowance for pensions (FVB)"
    source "PAP 2026, MRE4"
  }
  rule fvbz : money = pension_allowance.fvbz(annual = lzz == pay_period.year, zmvb = zmvb, vjahr = vjahr, vbezm = vbezm, vbezs = vbezs, vbezbso = 0 EUR, zvbezj = zvbezj) {
    label de "Zuschlag zum Versorgungsfreibetrag (FVBZ)"
    label en "supplement to the allowance for pensions (FVBZ)"
    source "PAP 2026, MRE4"
  }
  rule alte : money = old_age_relief.alte(alter1 = alter1, ajahr = ajahr, zre4j = zre4j, zvbezj = zvbezj) {
    label de "Altersentlastungsbetrag (ALTE)"
    label en "relief for old age (ALTE)"
    source "PAP 2026, MRE4ALTE"
  }

  // MBERECH: the annual tax on the current wage, and with the allowances for children
  rule st : money = annual_wage_tax.st(stkl = stkl, zkf = zkf, ins = ins, zre4j = zre4j, zvbezj = zvbezj, fvb = fvb, fvbz = fvbz, alte = alte, jlfreib = jlfreib, jlhinzu = jlhinzu, ent = 0 EUR) {
    label de "Jahressteuer auf den laufenden Arbeitslohn (ST)"
    label en "annual tax on the current wage (ST)"
    source "PAP 2026, MBERECH, MLSTJAHR"
  }
  rule lstjahr : money = round_down(st * factor, 1 EUR) {
    label de "Jahreslohnsteuer (LSTJAHR)"
    label en "annual wage tax (LSTJAHR)"
    source "PAP 2026, MBERECH"
  }
  rule jbmg : money = round_down(annual_wage_tax.st_children(stkl = stkl, zkf = zkf, ins = ins, zre4j = zre4j, zvbezj = zvbezj, fvb = fvb, fvbz = fvbz, alte = alte, jlfreib = jlfreib, jlhinzu = jlhinzu, ent = 0 EUR) * factor, 1 EUR) {
    label de "Jahressteuer nach § 51a EStG (JBMG)"
    label en "annual tax under § 51a EStG (JBMG)"
    source "PAP 2026, MBERECH (§ 51a EStG)"
  }

  // UPLSTLZZ, MSOLZ
  rule lstlzz_current : money = share.anteil1(lzz = lzz, jw = lstjahr) {
    label de "Lohnsteuer für den Lohnzahlungszeitraum vor STSMIN (LSTLZZ)"
    label en "wage tax for the pay period before STSMIN (LSTLZZ)"
    source "PAP 2026, UPLSTLZZ"
  }
  rule solzj : money = if jbmg > solzfrei * kztab then min(round_down(jbmg * 0.055, 0.01 EUR), round_down((jbmg - solzfrei * kztab) * 0.119, 0.01 EUR)) else 0 EUR {
    label de "Solidaritätszuschlag auf die Jahreslohnsteuer (SOLZJ)"
    label en "solidarity surcharge on the annual wage tax (SOLZJ)"
    source "PAP 2026, MSOLZ"
  }
  rule solzlzz_current : money = share.anteil1(lzz = lzz, jw = solzj) {
    label de "Solidaritätszuschlag für den Lohnzahlungszeitraum vor STSMIN (SOLZLZZ)"
    label en "solidarity surcharge for the pay period before STSMIN (SOLZLZZ)"
    source "PAP 2026, MSOLZ"
  }
  rule bk_current : money = if r then share.anteil1(lzz = lzz, jw = jbmg) else 0 EUR {
    label de "Bemessungsgrundlage der Kirchenlohnsteuer vor STSMIN (BK)"
    label en "base of the church wage tax before STSMIN (BK)"
    source "PAP 2026, MSOLZ (§ 51a EStG)"
  }

  // MSONST: the tax on other emoluments is the difference of the annual tax with them and without them. The
  // computation is always for a year (LZZ = 1); without ZMVB, twelve months.
  rule other : bool = sonstb != 0 EUR or mbv != 0 EUR {
    label de "sonstige Bezüge oder nicht zu besteuernde Vorteile vorhanden"
    label en "other emoluments or untaxed benefits given"
    source "PAP 2026, MSONST"
  }
  rule zmvb_other : int = if zmvb == 0 then 12 else zmvb {
    label de "ZMVB für die sonstigen Bezüge"
    label en "ZMVB for the other emoluments"
    source "PAP 2026, MSONST"
  }

  // MOSONST: without the other emoluments
  rule fvb_without : money = pension_allowance.fvb(annual = true, zmvb = zmvb_other, vjahr = vjahr, vbezm = vbezm, vbezs = vbezs, vbezbso = 0 EUR, zvbezj = jvbez) {
    label de "Versorgungsfreibetrag ohne sonstige Bezüge (FVB)"
    label en "allowance for pensions without other emoluments (FVB)"
    source "PAP 2026, MOSONST, MRE4"
  }
  rule fvbz_without : money = pension_allowance.fvbz(annual = true, zmvb = zmvb_other, vjahr = vjahr, vbezm = vbezm, vbezs = vbezs, vbezbso = 0 EUR, zvbezj = jvbez) {
    label de "Zuschlag zum Versorgungsfreibetrag ohne sonstige Bezüge (FVBZ)"
    label en "supplement without other emoluments (FVBZ)"
    source "PAP 2026, MOSONST, MRE4"
  }
  rule alte_without : money = old_age_relief.alte(alter1 = alter1, ajahr = ajahr, zre4j = jre4, zvbezj = jvbez) {
    label de "Altersentlastungsbetrag ohne sonstige Bezüge (ALTE)"
    label en "relief for old age without other emoluments (ALTE)"
    source "PAP 2026, MOSONST, MRE4ALTE"
  }
  rule lstoso : money = annual_wage_tax.st(stkl = stkl, zkf = zkf, ins = ins, zre4j = jre4, zvbezj = jvbez, fvb = fvb_without, fvbz = fvbz_without, alte = alte_without, jlfreib = jfreib, jlhinzu = jhinzu, ent = jre4ent) {
    label de "Jahressteuer ohne sonstige Bezüge (LSTOSO)"
    label en "annual tax without other emoluments (LSTOSO)"
    source "PAP 2026, MOSONST"
  }

  // MRE4SONST: with the other emoluments
  rule zre4j_with : money = jre4 + sonstb {
    label de "Jahresarbeitslohn mit sonstigen Bezügen (ZRE4J)"
    label en "annual wage with other emoluments (ZRE4J)"
    source "PAP 2026, MSONST"
  }
  rule zvbezj_with : money = jvbez + vbs {
    label de "Versorgungsbezüge mit sonstigen Bezügen (ZVBEZJ)"
    label en "pensions with other emoluments (ZVBEZJ)"
    source "PAP 2026, MSONST"
  }
  rule fvb_with : money = pension_allowance.fvbso(annual = true, zmvb = zmvb_other, vjahr = vjahr, vbezm = vbezm, vbezs = vbezs, vbezbso = sterbe, zvbezj = zvbezj_with) {
    label de "Versorgungsfreibetrag mit sonstigen Bezügen (FVB = FVBSO)"
    label en "allowance for pensions with other emoluments (FVB = FVBSO)"
    source "PAP 2026, MRE4SONST, MRE4"
  }
  rule fvbz_with : money = pension_allowance.fvbzso(annual = true, zmvb = zmvb_other, vjahr = vjahr, vbezm = vbezm, vbezs = vbezs, vbezbso = sterbe, zvbezj = zvbezj_with) {
    label de "Zuschlag zum Versorgungsfreibetrag mit sonstigen Bezügen (FVBZ = FVBZSO)"
    label en "supplement with other emoluments (FVBZ = FVBZSO)"
    source "PAP 2026, MRE4SONST, MRE4"
  }
  rule alte_with : money = old_age_relief.alte(alter1 = alter1, ajahr = ajahr, zre4j = zre4j_with, zvbezj = zvbezj_with) {
    label de "Altersentlastungsbetrag mit sonstigen Bezügen (ALTE)"
    label en "relief for old age with other emoluments (ALTE)"
    source "PAP 2026, MRE4SONST, MRE4ALTE"
  }
  rule lstso : money = annual_wage_tax.st(stkl = stkl, zkf = zkf, ins = ins, zre4j = zre4j_with, zvbezj = zvbezj_with, fvb = fvb_with, fvbz = fvbz_with, alte = alte_with, jlfreib = jfreib, jlhinzu = jhinzu, ent = jre4ent + sonstent - mbv) {
    label de "Jahressteuer mit sonstigen Bezügen (LSTSO)"
    label en "annual tax with other emoluments (LSTSO)"
    source "PAP 2026, MSONST"
  }
  rule sts_raw : money = (lstso - lstoso) * factor {
    label de "Lohnsteuer auf die sonstigen Bezüge vor dem Runden"
    label en "wage tax on the other emoluments before rounding"
    source "PAP 2026, MSONST"
  }
  rule sts_rounded : money {
    label de "Lohnsteuer auf die sonstigen Bezüge, auf volle Euro abgerundet – negative nach ihrem Betrag"
    label en "wage tax on the other emoluments, rounded down to full euros – negative ones by their amount"
    source "PAP 2026, MSONST"
    default round_down(sts_raw, 1 EUR)
    unless not other then 0 EUR
    unless sts_raw < 0 EUR then 0 EUR - round_down(0 EUR - sts_raw, 1 EUR)
  }

  // STSMIN, MSOLZSTS
  rule negative : bool = sts_rounded < 0 EUR {
    label de "negative Lohnsteuer auf den sonstigen Bezug (nur aus nicht zu besteuernden Vorteilen)"
    label en "negative wage tax on the other emolument (only from untaxed benefits)"
    source "PAP 2026, STSMIN"
  }
  rule offset : bool = negative and mbv != 0 EUR {
    label de "negativer Betrag mindert LSTLZZ, SOLZLZZ und BK"
    label en "the negative amount reduces LSTLZZ, SOLZLZZ and BK"
    source "PAP 2026, STSMIN"
  }
  rule sts : money = if negative then 0 EUR else sts_rounded {
    label de "Lohnsteuer für sonstige Bezüge (STS)"
    label en "wage tax on other emoluments (STS)"
    source "PAP 2026, STSMIN"
  }
  rule solzsbmg : money = round_down(annual_wage_tax.st_children(stkl = stkl, zkf = zkf, ins = ins, zre4j = zre4j_with, zvbezj = zvbezj_with, fvb = fvb_with, fvbz = fvbz_with, alte = alte_with, jlfreib = jfreib, jlhinzu = jhinzu, ent = jre4ent + sonstent - mbv) * factor, 1 EUR) {
    label de "Bemessungsgrundlage zur Prüfung der Freigrenze beim Solidaritätszuschlag (SOLZSBMG)"
    label en "base for the exemption limit of the solidarity surcharge (SOLZSBMG)"
    source "PAP 2026, MSOLZSTS"
  }
  rule solzs : money = if not negative and solzsbmg > solzfrei * kztab then round_down(sts * 0.055, 0.01 EUR) else 0 EUR {
    label de "Solidaritätszuschlag für sonstige Bezüge (SOLZS)"
    label en "solidarity surcharge on other emoluments (SOLZS)"
    source "PAP 2026, MSOLZSTS"
  }
  rule bks : money = if r then sts else 0 EUR {
    label de "Bemessungsgrundlage der sonstigen Bezüge für die Kirchenlohnsteuer (BKS)"
    label en "base of the church wage tax on other emoluments (BKS)"
    source "PAP 2026, STSMIN"
  }
  rule lstlzz : money = if offset then max(lstlzz_current + sts_rounded, 0 EUR) else lstlzz_current {
    label de "Lohnsteuer für den Lohnzahlungszeitraum (LSTLZZ)"
    label en "wage tax for the pay period (LSTLZZ)"
    source "PAP 2026, UPLSTLZZ, STSMIN"
  }
  rule solzlzz : money {
    label de "Solidaritätszuschlag für den Lohnzahlungszeitraum (SOLZLZZ)"
    label en "solidarity surcharge for the pay period (SOLZLZZ)"
    source "PAP 2026, MSOLZ, STSMIN"
    default solzlzz_current
    unless offset and solzlzz_current + sts_rounded * 0.055 < 0 EUR then 0 EUR
    unless offset then round_down(solzlzz_current + sts_rounded * 0.055, 0.01 EUR)
  }
  rule bk : money = if offset then max(bk_current + sts_rounded, 0 EUR) else bk_current {
    label de "Bemessungsgrundlage der Kirchenlohnsteuer (BK)"
    label en "base of the church wage tax (BK)"
    source "PAP 2026, MSOLZ, STSMIN (§ 51a EStG)"
  }

  // Outputs for the plan on double taxation treaties (Anlage 3)
  rule vfrb : money = annual_wage_tax.vfrb(stkl = stkl, zkf = zkf, ins = ins, zre4j = zre4j, zvbezj = zvbezj, fvb = fvb, fvbz = fvbz, alte = alte, jlfreib = jlfreib, jlhinzu = jlhinzu, ent = 0 EUR) {
    label de "verbrauchter Freibetrag beim laufenden Arbeitslohn (VFRB)"
    label en "allowance used on the current wage (VFRB)"
    source "PAP 2026, MBERECH"
  }
  rule wvfrb : money = annual_wage_tax.wvfrb(stkl = stkl, zkf = zkf, ins = ins, zre4j = zre4j, zvbezj = zvbezj, fvb = fvb, fvbz = fvbz, alte = alte, jlfreib = jlfreib, jlhinzu = jlhinzu, ent = 0 EUR) {
    label de "verfügbares ZVE über dem Grundfreibetrag beim laufenden Arbeitslohn (WVFRB)"
    label en "taxable income above the basic allowance, current wage (WVFRB)"
    source "PAP 2026, MBERECH"
  }
  rule vfrbs1 : money {
    label de "verbrauchter Freibetrag beim voraussichtlichen Jahresarbeitslohn (VFRBS1)"
    label en "allowance used on the expected annual wage (VFRBS1)"
    source "PAP 2026, MOSONST"
    default annual_wage_tax.vfrb(stkl = stkl, zkf = zkf, ins = ins, zre4j = jre4, zvbezj = jvbez, fvb = fvb_without, fvbz = fvbz_without, alte = alte_without, jlfreib = jfreib, jlhinzu = jhinzu, ent = jre4ent)
    unless not other then 0 EUR
  }
  rule wvfrbo : money {
    label de "verfügbares ZVE über dem Grundfreibetrag beim voraussichtlichen Jahresarbeitslohn (WVFRBO)"
    label en "taxable income above the basic allowance, expected annual wage (WVFRBO)"
    source "PAP 2026, MOSONST"
    default annual_wage_tax.wvfrb(stkl = stkl, zkf = zkf, ins = ins, zre4j = jre4, zvbezj = jvbez, fvb = fvb_without, fvbz = fvbz_without, alte = alte_without, jlfreib = jfreib, jlhinzu = jhinzu, ent = jre4ent)
    unless not other then 0 EUR
  }
  rule vfrbs2 : money {
    label de "verbrauchter Freibetrag bei den sonstigen Bezügen (VFRBS2)"
    label en "allowance used on the other emoluments (VFRBS2)"
    source "PAP 2026, MRE4SONST"
    default annual_wage_tax.vfrb(stkl = stkl, zkf = zkf, ins = ins, zre4j = zre4j_with, zvbezj = zvbezj_with, fvb = fvb_with, fvbz = fvbz_with, alte = alte_with, jlfreib = jfreib, jlhinzu = jhinzu, ent = jre4ent + sonstent - mbv) - vfrbs1
    unless not other then 0 EUR
  }
  rule wvfrbm : money {
    label de "verfügbares ZVE über dem Grundfreibetrag bei den sonstigen Bezügen (WVFRBM)"
    label en "taxable income above the basic allowance, other emoluments (WVFRBM)"
    source "PAP 2026, MSONST"
    default annual_wage_tax.wvfrb(stkl = stkl, zkf = zkf, ins = ins, zre4j = zre4j_with, zvbezj = zvbezj_with, fvb = fvb_with, fvbz = fvbz_with, alte = alte_with, jlfreib = jfreib, jlhinzu = jhinzu, ent = jre4ent + sonstent - mbv)
    unless not other then 0 EUR
  }
}

example general_class_i_40000 {
  label de "Prüftabelle allgemeine Lohnsteuer: 40.000 €, Steuerklasse I – 4.407 €"
  label en "Test table, general wage tax: 40,000 euros, class I – 4,407 euros"
  statement lean "wage_tax.lstjahr { stkl := .i, lzz := .year, wage := 40000, zkf := 0, r := false, ins := { krv := false, alv := false, pkv := false, kvz := 29 / 10, pvs := false, pvz := true, pva := 0, pkpv := 0, pkpvagz := 0 }, af := false, f := 1, lzzfreib := 0, lzzhinzu := 0, vbez := 0, vbezm := 0, vbezs := 0, vjahr := 0, zmvb := 0, alter1 := false, ajahr := 0, sonstb := 0, sonstent := 0, sterbe := 0, vbs := 0, mbv := 0, jre4 := 0, jre4ent := 0, jvbez := 0, jfreib := 0, jhinzu := 0 } = 4407"
  proof lean "by norm_num [tariff.gfb, tariff.y, tariff.z, tariff.st, class_5_6_step.st1, class_5_6_step.st2, class_5_6_step.diff, class_5_6_step.mist, class_5_6_step.st, annual_tax.w1stkl5, annual_tax.w2stkl5, annual_tax.w3stkl5, annual_tax.x, annual_tax.st_5_6, annual_tax.st, share.anteil1, projection.year, pension_tables.tab1, pension_tables.tab2, pension_tables.tab3, relief_tables.tab4, relief_tables.tab5, pension_allowance.tab1, pension_allowance.tab2, pension_allowance.tab3, pension_allowance.vbezb, pension_allowance.hfvb, pension_allowance.fvbz_table, pension_allowance.fvb, pension_allowance.fvbso, pension_allowance.hfvbzso, pension_allowance.fvbzso_raw, pension_allowance.fvbzso, pension_allowance.hfvbz, pension_allowance.fvbz, old_age_relief.alte, annual_wage_tax.bbgrvalv, annual_wage_tax.avsatzan, annual_wage_tax.rvsatzan, annual_wage_tax.bbgkvpv, annual_wage_tax.kvsatzan, annual_wage_tax.pvsatzan, annual_wage_tax.zre4, annual_wage_tax.zre4vp, annual_wage_tax.zvbez, annual_wage_tax.fvbz_limited, annual_wage_tax.fvbz_table, annual_wage_tax.anp_pension, annual_wage_tax.anp, annual_wage_tax.efa, annual_wage_tax.sap, annual_wage_tax.kztab, annual_wage_tax.kfb, annual_wage_tax.ztabfb, annual_wage_tax.vspr, annual_wage_tax.vspkvpv, annual_wage_tax.vsp_basic, annual_wage_tax.vspalv, annual_wage_tax.vsphb, annual_wage_tax.vspn, annual_wage_tax.vsp, annual_wage_tax.zve, annual_wage_tax.st, annual_wage_tax.st_children, annual_wage_tax.vfrb, annual_wage_tax.wvfrb, wage_tax.solzfrei, wage_tax.factor, wage_tax.kztab, wage_tax.zre4j, wage_tax.zvbezj, wage_tax.jlfreib, wage_tax.jlhinzu, wage_tax.fvb, wage_tax.fvbz, wage_tax.alte, wage_tax.st, wage_tax.lstjahr, wage_tax.jbmg, wage_tax.lstlzz_current, wage_tax.solzj, wage_tax.solzlzz_current, wage_tax.bk_current, wage_tax.other, wage_tax.zmvb_other, wage_tax.fvb_without, wage_tax.fvbz_without, wage_tax.alte_without, wage_tax.lstoso, wage_tax.zre4j_with, wage_tax.zvbezj_with, wage_tax.fvb_with, wage_tax.fvbz_with, wage_tax.alte_with, wage_tax.lstso, wage_tax.sts_raw, wage_tax.sts_rounded, wage_tax.negative, wage_tax.offset, wage_tax.sts, wage_tax.solzsbmg, wage_tax.solzs, wage_tax.bks, wage_tax.lstlzz, wage_tax.solzlzz, wage_tax.bk, wage_tax.vfrb, wage_tax.wvfrb, wage_tax.vfrbs1, wage_tax.wvfrbo, wage_tax.vfrbs2, wage_tax.wvfrbm, verkodo.round_down, verkodo.round_up]"
}

example general_class_iii_40000 {
  label de "Prüftabelle allgemeine Lohnsteuer: 40.000 €, Steuerklasse III – 1.000 €"
  label en "Test table, general wage tax: 40,000 euros, class III – 1,000 euros"
  statement lean "wage_tax.lstjahr { stkl := .iii, lzz := .year, wage := 40000, zkf := 0, r := false, ins := { krv := false, alv := false, pkv := false, kvz := 29 / 10, pvs := false, pvz := true, pva := 0, pkpv := 0, pkpvagz := 0 }, af := false, f := 1, lzzfreib := 0, lzzhinzu := 0, vbez := 0, vbezm := 0, vbezs := 0, vjahr := 0, zmvb := 0, alter1 := false, ajahr := 0, sonstb := 0, sonstent := 0, sterbe := 0, vbs := 0, mbv := 0, jre4 := 0, jre4ent := 0, jvbez := 0, jfreib := 0, jhinzu := 0 } = 1000"
  proof lean "by norm_num [tariff.gfb, tariff.y, tariff.z, tariff.st, class_5_6_step.st1, class_5_6_step.st2, class_5_6_step.diff, class_5_6_step.mist, class_5_6_step.st, annual_tax.w1stkl5, annual_tax.w2stkl5, annual_tax.w3stkl5, annual_tax.x, annual_tax.st_5_6, annual_tax.st, share.anteil1, projection.year, pension_tables.tab1, pension_tables.tab2, pension_tables.tab3, relief_tables.tab4, relief_tables.tab5, pension_allowance.tab1, pension_allowance.tab2, pension_allowance.tab3, pension_allowance.vbezb, pension_allowance.hfvb, pension_allowance.fvbz_table, pension_allowance.fvb, pension_allowance.fvbso, pension_allowance.hfvbzso, pension_allowance.fvbzso_raw, pension_allowance.fvbzso, pension_allowance.hfvbz, pension_allowance.fvbz, old_age_relief.alte, annual_wage_tax.bbgrvalv, annual_wage_tax.avsatzan, annual_wage_tax.rvsatzan, annual_wage_tax.bbgkvpv, annual_wage_tax.kvsatzan, annual_wage_tax.pvsatzan, annual_wage_tax.zre4, annual_wage_tax.zre4vp, annual_wage_tax.zvbez, annual_wage_tax.fvbz_limited, annual_wage_tax.fvbz_table, annual_wage_tax.anp_pension, annual_wage_tax.anp, annual_wage_tax.efa, annual_wage_tax.sap, annual_wage_tax.kztab, annual_wage_tax.kfb, annual_wage_tax.ztabfb, annual_wage_tax.vspr, annual_wage_tax.vspkvpv, annual_wage_tax.vsp_basic, annual_wage_tax.vspalv, annual_wage_tax.vsphb, annual_wage_tax.vspn, annual_wage_tax.vsp, annual_wage_tax.zve, annual_wage_tax.st, annual_wage_tax.st_children, annual_wage_tax.vfrb, annual_wage_tax.wvfrb, wage_tax.solzfrei, wage_tax.factor, wage_tax.kztab, wage_tax.zre4j, wage_tax.zvbezj, wage_tax.jlfreib, wage_tax.jlhinzu, wage_tax.fvb, wage_tax.fvbz, wage_tax.alte, wage_tax.st, wage_tax.lstjahr, wage_tax.jbmg, wage_tax.lstlzz_current, wage_tax.solzj, wage_tax.solzlzz_current, wage_tax.bk_current, wage_tax.other, wage_tax.zmvb_other, wage_tax.fvb_without, wage_tax.fvbz_without, wage_tax.alte_without, wage_tax.lstoso, wage_tax.zre4j_with, wage_tax.zvbezj_with, wage_tax.fvb_with, wage_tax.fvbz_with, wage_tax.alte_with, wage_tax.lstso, wage_tax.sts_raw, wage_tax.sts_rounded, wage_tax.negative, wage_tax.offset, wage_tax.sts, wage_tax.solzsbmg, wage_tax.solzs, wage_tax.bks, wage_tax.lstlzz, wage_tax.solzlzz, wage_tax.bk, wage_tax.vfrb, wage_tax.wvfrb, wage_tax.vfrbs1, wage_tax.wvfrbo, wage_tax.vfrbs2, wage_tax.wvfrbm, verkodo.round_down, verkodo.round_up]"
}

example general_class_v_40000 {
